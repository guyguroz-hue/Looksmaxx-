# Supabase — Project Settings → API
#
# The anon key is public by design. It is safe in client code *because*
# row-level security decides what it can reach, not because it is secret.
# Never put the service_role key here: it bypasses RLS entirely.
#
# Leave both unset and the app works completely — everything stays in
# localStorage and the account panel explains that.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
